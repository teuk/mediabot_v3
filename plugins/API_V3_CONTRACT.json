      "event",
      "http_callback",
      "job"
    ],
    "maximum_entries": 64,
    "scope": "exact resource and channel",
    "channel_casemapping": "rfc1459",
    "resource_validation": "declared by current manifest",
    "set": "idempotent",
    "release": "idempotent exact entry",
    "disable_enable": "preserve",
    "unload_reload": "discard",
    "failure_history": "preserve",
    "automatic_trigger": "none",
    "persistent_state": "none",
    "late_output_guards": true,
    "partyline": [
      "quarantine",
      "unquarantine",
      "quarantines"
    ]
