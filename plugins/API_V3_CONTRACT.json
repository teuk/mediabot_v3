{
  "api": 3,
  "status": "experimental",
  "milestone": "MB762",
  "compatibility_dispatch_tables": 0,
  "activation_default": "off",
  "manifest_file": "plugin.json",
  "manifest_max_bytes": 16384,
  "runtime_kinds": [
    "perl"
  ],
  "capability_model": "requested intersection granted",
  "channel_policy": {
    "modes": [
      "off",
      "observe",
      "on"
    ],
    "default": "off",
    "maximum_channels_per_plugin": 128,
    "casemapping": "rfc1459",
    "observe_output": "suppressed"
  },
  "typed_config": {
    "types": [
      "boolean",
      "integer",
      "string"
    ],
    "maximum_fields": 32,
    "maximum_effective_bytes": 4096,
    "unknown_fields": "reject"
  },
  "capabilities": [
    "channel.topic",
    "data.<domain>",
    "events.subscribe",
    "http.fetch",
    "irc.notice",
    "irc.reply",
    "irc.channel_message",
    "moderation.ban",
    "moderation.kick",
    "scheduler.jobs",
    "secrets.read:<name>",
    "storage.kv"
  ],
  "implemented_capabilities": [
    "data.factoids.read",
    "data.factoids.write",
    "data.quotes.read",
    "data.quotes.write",
    "events.subscribe",
    "http.fetch",
    "irc.channel_message",
    "irc.notice",
    "irc.reply",
    "scheduler.jobs",
    "storage.kv"
  ],
  "plugin_receives": [
    "Mediabot::PluginContext",
    "Mediabot::Plugin::InvocationV3",
    "Mediabot::Plugin::PrincipalV3",
    "Mediabot::Plugin::EventEnvelopeV3",
    "Mediabot::Plugin::JobInvocationV3",
    "Mediabot::Plugin::HTTPResponseV3",
    "Mediabot::Plugin::FactoidRecordV3",
    "Mediabot::Plugin::QuoteRecordV3"
  ],
  "plugin_never_receives": [
    "Mediabot",
    "Mediabot::Context",
    "IRC socket",
    "database handle"
  ],
  "lifecycle": [
    "construct",
    "start",
    "stop"
  ],
  "event_backpressure": {
    "max_pending_per_plugin": 32,
    "dispatch_batch_size": 8,
    "overflow_policy": "drop newest"
  },
  "scheduler_limits": {
    "max_jobs_per_plugin": 8,
    "minimum_interval_seconds": 5,
    "maximum_interval_seconds": 86400
  },
  "http_limits": {
    "scheme": "https",
    "port": 443,
    "maximum_redirects": 2,
    "maximum_timeout_seconds": 10,
    "maximum_body_bytes": 65536,
    "maximum_inflight_per_plugin": 2,
    "maximum_cache_entries": 128,
    "circuit_failures": 3,
    "circuit_seconds": 60,
    "private_addresses": "reject",
    "ambient_proxies": "disabled"
  },
  "storage_limits": {
    "maximum_values": 64,
    "maximum_value_bytes": 2048,
    "write_mode": "compare-and-swap",
    "observe_writes": "suppressed",
    "operator_cleanup": "Owner-only clearv3data with core-derived namespace",
    "cleanup_loaded_or_unloaded": true,
    "plugin_paths": "unavailable",
    "plugin_database_handles": "unavailable"
  },
  "factoid_read_limits": {
    "capability": "data.factoids.read",
    "operations": [
      "by_keyword",
      "list",
      "top"
    ],
    "maximum_keyword_characters": 64,
    "maximum_pattern_characters": 64,
    "maximum_list_results": 60,
    "maximum_top_results": 10,
    "pattern_mode": "validated glob with literal SQL wildcard escaping",
    "channel_source": "invocation policy",
    "observe_reads": "allowed",
    "recall_counter_writes": "unavailable",
    "plugin_adoption": "factoids-v3 factoid, factoids, learn and forget, inactive by default",
    "plugin_sql": "unavailable",
    "plugin_database_handles": "unavailable"
  },
  "factoid_write_limits": {
    "capability": "data.factoids.write",
    "operations": [
      "upsert",
      "delete",
      "recall"
    ],
    "activation": "on only",
    "observe_writes": "suppressed",
    "maximum_keyword_characters": 64,
    "maximum_value_characters": 400,
    "maximum_value_bytes": 400,
    "channel_source": "core invocation policy",
    "principal_source": "core command context",
    "actor_nick_source": "core command invocation",
    "invocation_origin": "opaque runtime authority required",
    "upsert_attribution": "authenticated user id or SQL NULL plus bounded current IRC nickname",
    "existing_author_on_update": "preserved",
    "delete_authorization": "authenticated numeric author, Administrator global level, or channel level 400",
    "recall_counter_writes": "on-only exact channel and keyword increment",
    "plugin_sql": "unavailable",
    "plugin_database_handles": "unavailable",
    "schema_administration": "unavailable",
    "plugin_adoption": "factoids-v3 learn and forget, inactive by default"
  },
  "factoid_recall_authority": {
    "capability": "data.factoids.write",
    "operation": "recall",
    "activation": "on only",
    "channel_source": "core invocation policy",
    "key": "normalized bounded keyword",
    "mutation": "single COALESCE(hits, 0) increment",
    "observe_writes": "suppressed before service",
    "command_adoption": "none in MB762",
    "plugin_sql": "unavailable"
  },
  "factoid_write_migration": {
    "package": "factoids-v3",
    "commands": [
      "learn",
      "forget"
    ],
    "excluded_commands": [
      "whatis",
      "?keyword"
    ],
    "observe_mutations": "v3 suppressed; historical fallback remains authoritative",
    "on_mutations": "one core-authorized write with v3 output",
    "activation": "explicit package plus channel policy"
  },
  "factoid_read_migration": {
    "package": "factoids-v3",
    "commands": [
      "factoid",
      "factoids"
    ],
    "excluded_commands": [
      "whatis",
      "?keyword"
    ],
    "read_side_effects": "none",
    "activation": "explicit package plus channel policy"
  },
  "quote_read_limits": {
    "capability": "data.quotes.read",
    "operations": [
      "by_id",
      "random",
      "search",
      "by_author",
      "random_by_author",
      "count",
      "top",
      "stats"
    ],
    "maximum_results": 20,
    "maximum_search_results": 51,
    "maximum_query_bytes": 256,
    "maximum_search_words": 8,
    "author_count_match_modes": [
      "exact",
      "prefix"
    ],
    "random_author_match_modes": [
      "prefix",
      "contains"
    ],
    "channel_source": "invocation policy",
    "observe_reads": "allowed",
    "writes": "separate data.quotes.write capability",
    "plugin_sql": "unavailable",
    "plugin_database_handles": "unavailable"
  },
  "invocation_principal": {
    "mode": "detached immutable scalar snapshot",
    "source": "core command context",
    "write_origin": "opaque runtime authority required",
    "fields": [
      "authenticated",
      "user_id",
      "account",
      "global_level",
      "channel_level"
    ],
    "anonymous_defaults": "unauthenticated with zero levels",
    "passwords": "unavailable",
    "hostmasks": "unavailable",
    "raw_messages": "unavailable"
  },
  "quote_write_limits": {
    "capability": "data.quotes.write",
    "operations": [
      "add",
      "delete",
      "recall"
    ],
    "activation": "on only",
    "observe_writes": "suppressed",
    "maximum_quote_chars": 512,
    "maximum_quote_bytes": 2048,
    "channel_source": "core invocation policy",
    "principal_source": "core command context",
    "invocation_origin": "opaque runtime authority required",
    "add_attribution": "authenticated user id or SQL NULL for anonymous",
    "delete_authorization": "quote author, Administrator global level, or configured channel level",
    "plugin_sql": "unavailable",
    "plugin_database_handles": "unavailable",
    "schema_administration": "unavailable",
    "plugin_adoption": "quotes-v3 q and quote, inactive by default"
  },
  "command_migration": {
    "mode": "legacy-public-fallback",
    "eligible_target": "registry-native public built-in with migration_fallback metadata",
    "off": "saved built-in registry handler",
    "observe": "plugin shadow plus visible saved built-in handler",
    "on": "plugin",
    "unload": "restore exact previous registry entry"
  },
  "quote_read_migration": {
    "package": "quotes-v3",
    "commands": [
      "q",
      "quote",
      "quotecount",
      "topquote",
      "halloffame"
    ],
    "mixed_read_write_commands": "reversible quotes-v3 adoption",
    "activation": "explicit package plus channel policy"
  },
  "operator_diagnostics": {
    "commands": [
      "doctor",
      "failures",
      "quarantines",
      "permissions",
      "why"
    ],
    "mode": "read-only",
    "configuration_values": "unavailable",
    "capability_view": "requested, granted, effective, missing",
    "channel_decisions": [
      "blocked",
      "shadow",
      "active"
    ],
    "automatic_remediation": "none"
  },
  "runtime_failure_history": {
    "mode": "read-only in-memory per loaded instance",
    "kinds": [
      "command",
      "event",
      "http_callback",
      "job"
    ],
    "maximum_recent_records": 16,
    "maximum_resource_states": 128,
    "partyline_recent_records": 5,
    "error_text": "unavailable",
    "fingerprint": "first 16 hexadecimal characters of instance-salted SHA-256",
    "success": "reset matching consecutive-failure streak",
    "disable_enable": "preserve",
    "unload_reload": "discard",
    "readiness_effect": "none",
    "automatic_quarantine": "none",
    "reset_control": "none"
  },
  "manual_quarantine": {
