{
  "api": 3,
  "status": "experimental",
  "milestone": "MB743",
  "activation_default": "off",
  "manifest_file": "plugin.json",
  "manifest_max_bytes": 16384,
  "runtime_kinds": [
    "perl"
  ],
  "capability_model": "requested intersection granted",
  "capabilities": [
    "channel.topic",
    "data.<domain>",
    "events.subscribe",
    "http.fetch",
    "irc.notice",
    "irc.reply",
    "moderation.ban",
    "moderation.kick",
    "scheduler.jobs",
    "secrets.read:<name>",
    "storage.kv"
  ],
  "implemented_capabilities": [
    "events.subscribe",
    "irc.notice",
    "irc.reply",
    "scheduler.jobs"
  ],
  "plugin_receives": [
    "Mediabot::PluginContext",
    "Mediabot::Plugin::InvocationV3",
    "Mediabot::Plugin::EventEnvelopeV3",
    "Mediabot::Plugin::JobInvocationV3"
  ],
  "plugin_never_receives": [
    "Mediabot",
    "Mediabot::Context",
    "IRC socket",
    "database handle"
  ],
  "lifecycle": [
    "construct",
    "start",
    "stop"
  ],
  "event_backpressure": {
    "max_pending_per_plugin": 32,
    "dispatch_batch_size": 8,
    "overflow_policy": "drop newest"
  },
  "scheduler_limits": {
    "max_jobs_per_plugin": 8,
    "minimum_interval_seconds": 5,
    "maximum_interval_seconds": 86400
  },
  "deferred_to": {
    "channel_policy_and_config": "MB744",
    "production_proof": "MB745"
  }
}
