{
  "api": 3,
  "name": "factoids-v3",
  "version": "1.2.0",
  "description": "A reversible API v3 home for bounded factoid reads, recalls and authorized channel-scoped writes.",
  "runtime": {
    "api": 3,
    "kind": "perl",
    "entrypoint": "lib/Factoids.pm",
    "class": "Mediabot::Plugin::Factoids"
  },
  "compatibility": {
    "mediabot": ">=3.6dev"
  },
  "activation": {
    "default": "off"
  },
  "capabilities": [
    "data.factoids.read",
    "data.factoids.write",
    "irc.reply",
    "irc.notice"
  ],
  "commands": {
    "factoid": {
      "source": "public",
      "help": "Show one factoid with its author, dates and recall count.",
      "level": 0,
      "handler": "command_factoid",
      "migration": "legacy-public-fallback"
    },
    "factoids": {
      "source": "public",
      "help": "List channel factoids or show the most recalled entries.",
      "level": 0,
      "handler": "command_factoids",
      "migration": "legacy-public-fallback"
    },
    "forget": {
      "source": "public",
      "help": "Delete an authored channel factoid or use operator authority.",
      "level": 0,
      "handler": "command_forget",
      "migration": "legacy-public-fallback"
    },
    "learn": {
      "source": "public",
      "help": "Store or update a bounded channel factoid.",
      "level": 0,
      "handler": "command_learn",
      "migration": "legacy-public-fallback"
    },
    "whatis": {
      "source": "public",
      "help": "Recall one channel factoid and increment its bounded counter.",
      "level": 0,
      "handler": "command_whatis",
      "migration": "legacy-public-fallback"
    }
  },
  "events": [],
  "jobs": {},
  "config_schema": {}
}
