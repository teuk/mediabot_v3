{
  "api": 3,
  "name": "estimate-v3",
  "version": "0.1.0",
  "description": "Estimate the time for a batch of tasks using a channel setting.",
  "runtime": {"kind": "python", "entrypoint": "lib/estimate.py"},
  "activation": {"default": "off"},
  "capabilities": ["irc.reply"],
  "commands": {
    "v3estime": {
      "source": "public",
      "level": 0,
      "handler": "command_estimate",
      "help": "v3estime <1-100> - estimate the time for a batch of tasks."
    }
  },
  "events": [],
  "jobs": {},
  "config_schema": {
    "minutes_per_task": {"type": "integer", "default": 5, "minimum": 1, "maximum": 120}
  }
}
