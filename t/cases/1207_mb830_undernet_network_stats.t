use strict;
use warnings;
use Test::More;
use File::Temp qw(tempdir);
use File::Path qw(make_path);
use Cwd qw(getcwd);
use JSON::PP;
use Mediabot::Conf;
use Mediabot::NetworkStats;

my $dir=tempdir(CLEANUP=>1);
make_path("$dir/mediabot3", "$dir/mediabot_v3");
my $config="$dir/mediabot3/mbundernet.conf";
my $output="$dir/mediabot3/var/network-stats.json";
open my $fh,'>',$config or die $!;
print {$fh} "[connection]\nCONN_SERVER_NETWORK=Undernet\n[main]\nMAIN_PROG_LANG=en\n";
close $fh;
my $dev="$dir/mediabot_v3/mediabot.conf";
open $fh,'>',$dev or die $!;print {$fh} "[connection]\nCONN_SERVER_NETWORK=TeuK\n";close $fh;
my $cwd=getcwd();chdir "$dir/mediabot_v3" or die $!;
my $ok=eval {
    my $conf=Mediabot::Conf->new({},$config);
    my $disabled=Mediabot::NetworkStats->new(conf=>$conf);
    ok(!$disabled->{enabled},'Undernet export remains disabled until its own configuration enables it');
    $conf->set('network_stats.ENABLED',1);
    $conf->set('network_stats.OUTPUT_FILE',$output);
    $conf->set('main.LUSERS_REFRESH',300);
    $conf->save;
    my $read=Mediabot::Conf->new({},$config);
    is($read->get('network_stats.OUTPUT_FILE'),$output,'native writer retains the absolute Undernet snapshot path');
    is($read->get('main.MAIN_PROG_LANG'),'en','other instance settings are retained');
    my $clock=1700000000;
    my $exporter=Mediabot::NetworkStats->new(conf=>$read,now=>sub {$clock});
    is($exporter->{network},'Undernet','network label comes from mbundernet.conf');
    is($exporter->{interval},300,'five-minute interval is retained');
    $exporter->observe('251',['mediabot'],'There are 12000 users and 33000 invisible on 35 servers');
    $exporter->observe('252',['mediabot',45],'operator(s) online');
    $exporter->observe('254',['mediabot',10000],'channels formed');
    $exporter->observe('255',['mediabot'],'I have 2000 clients and 1 servers');
    $clock+=3;
    ok($exporter->flush,'251 through 255 suffice; optional 265/266 are not required');
    open my $in,'<:raw',$output or die $!;local $/;my $raw=<$in>;close $in;
    my $sample=decode_json($raw);
    is($sample->{network},'Undernet','export identifies the requested network');
    is($sample->{counts}{users},45000,'visible and invisible counts form the total');
    is($sample->{counts}{invisible_users},33000,'invisible count is retained');
    is($sample->{counts}{operators},45,'IRC operators are retained');
    is($sample->{counts}{channels},10000,'formed channels are retained');
    is($sample->{counts}{local_users},2000,'local client scope is retained');
    ok(!exists $sample->{counts}{users_max},'unsupported global peak remains unknown');
    ok(!-e "$dir/mediabot_v3/var/network-stats.json",'a dev working directory cannot redirect the absolute Undernet export');
    open $in,'<',$dev or die $!;my $unchanged=<$in>;close $in;
    is($unchanged,"[connection]\nCONN_SERVER_NETWORK=TeuK\n",'dev configuration is unchanged');
    is((stat($output))[2]&0777,0600,'aggregate snapshot remains private');
    1;
};
my $error=$@;chdir $cwd or die $!;die $error unless $ok;

my $status=system('python3','-B','contrib/network-stats/test_add_local.py');
is($status,0,'existing hub extension, real HTTP/history, credentials, idempotence and rollback contracts');
done_testing;
