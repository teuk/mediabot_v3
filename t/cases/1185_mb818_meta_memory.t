use strict;
use warnings;
use utf8;
use Test::More;
use File::Temp qw(tempdir);
use Fcntl qw(:DEFAULT :flock);
use JSON::PP ();
use Mediabot::AI::MetaMemory;
my $dir=tempdir(CLEANUP=>1);my $path="$dir/private/memory.json";my $now=1000;
my $memory=Mediabot::AI::MetaMemory->new(path=>$path,ttl=>300,turns=>2,clock=>sub {$now});
my $ticket=$memory->begin_turn('dev:network:#room','alice!u!host','How heavy is a proton?',10);
is($ticket->{speaker},'speaker1','first identity gets a local label');
is_deeply($ticket->{messages},[{role=>'user',content=>'speaker1: How heavy is a proton?'}],'only explicitly addressed text enters the context');
ok($memory->commit_turn($ticket,'About 1.67e-27 kg.'),'delivered turn is persisted');
is((stat $path)[2]&0777,0600,'persistent memory is private');
is((stat "$path.lock")[2]&0777,0600,'lock file is also private');
my $again=Mediabot::AI::MetaMemory->new(path=>$path,ttl=>300,turns=>2,clock=>sub {$now});
my $second=$again->begin_turn('dev:network:#room','bob!u!elsewhere','And the neutron?',10);
is($second->{speaker},'speaker2','another participant stays a distinct identity');
is(scalar(@{$second->{messages}}),3,'another participant can continue the previous turn after restart');
like($second->{messages}[0]{content},qr/How heavy is a proton/,'earlier question is present');
like($second->{messages}[1]{content},qr/1.67e-27/,'earlier delivered answer is present');
ok($again->commit_turn($second,'A little heavier.'),'second speaker turn is persisted');
my $isolated=$again->begin_turn('dev:network:#else','bob!u!elsewhere','And it?',10);
is(scalar(@{$isolated->{messages}}),1,'channel isolation is exact');
my $other_network=$again->begin_turn('dev:other-network:#room','bob!u!elsewhere','And it?',10);
is(scalar(@{$other_network->{messages}}),1,'network isolation is exact');
my $other_instance=$again->begin_turn('prod:network:#room','bob!u!elsewhere','And it?',10);
is(scalar(@{$other_instance->{messages}}),1,'instance isolation is exact');
ok($again->rename_actor('alice!u!host','wizard!u!host'),'observed IRC rename keeps the speaker label');
my $renamed=$again->begin_turn('dev:network:#room','wizard!u!host','Continue',10);
is($renamed->{speaker},'speaker1','renamed identity retains the label');
ok($again->forget_actor('dev:network:#room','wizard!u!host'),'personal forget succeeds');
ok(!$again->current($renamed),'forget invalidates an in-flight ticket');
ok(!$again->commit_turn($renamed,'Stale answer'),'late result cannot restore erased data');
my $remaining=$again->begin_turn('dev:network:#room','bob!u!elsewhere','Continue',10);
is(scalar(@{$remaining->{messages}}),3,'forget retains the other participant turn');
unlike(join(' ',map {$_->{content}} @{$remaining->{messages}}),qr/proton|1.67e-27/,'own erased question and answer are absent');
ok($again->commit_turn($remaining,'Third answer'),'new turn succeeds after erasure');
my $limit=$again->begin_turn('dev:network:#room','bob!u!elsewhere','Fourth?',10);
ok($again->commit_turn($limit,'Fourth answer'),'bounded history keeps later turns');
my $budget=$again->begin_turn('dev:network:#room','bob!u!elsewhere','Fifth?',8);
is($budget->{error},'daily_limit','daily budget survives new store objects');
$now+=301;
my $fresh=$again->begin_turn('dev:network:#room','bob!u!elsewhere','New discussion',100);
is(scalar(@{$fresh->{messages}}),1,'expired history never enters a new request');
open my $fh,'<:raw',$path or die $!;local $/;my $raw=<$fh>;close $fh;
unlike($raw,qr/alice|wizard|bob|elsewhere|host/,'raw nicks and host metadata are not stored');
my $broken="$dir/broken.json";open my $bad,'>:raw',$broken or die $!;print {$bad} '{bad';close $bad;
my $store=Mediabot::AI::MetaMemory->new(path=>$broken);
ok(!eval {$store->begin_turn('scope','actor','prompt',10);1},'corrupt memory refuses access');
open my $read,'<:raw',$broken;is(do {local $/;<$read>},'{bad','corrupt data is preserved for recovery');close $read;
my $link="$dir/link.json";symlink($broken,$link) or die $!;
my $linked=Mediabot::AI::MetaMemory->new(path=>$link);
ok(!eval {$linked->begin_turn('scope','actor','prompt',10);1},'symbolic memory path is refused');
sysopen(my $held,"$path.lock",O_RDWR) or die $!;flock($held,LOCK_EX) or die $!;
ok(!eval {$again->begin_turn('scope','actor','prompt',100);1},'busy lock fails without blocking the IRC process');
close $held;
done_testing;
