use strict;
use warnings;
use Test::More;
use DBI;
use Mediabot::AI::MetaActivation qw(channel_policy activation_plan initialize_chanset);
use Mediabot::AI::MetaPolicy qw(settings);
{package MB842Conf;sub get {$_[0]{$_[1]}}}
sub fixture842 {
 my $dbh=DBI->connect('dbi:SQLite:dbname=:memory:','','',{RaiseError=>1,PrintError=>0});
 $dbh->do('CREATE TABLE CHANSET_LIST(id_chanset_list INTEGER PRIMARY KEY,chanset TEXT UNIQUE COLLATE NOCASE)');
 $dbh->do('CREATE TABLE CHANNEL(id_channel INTEGER PRIMARY KEY,name TEXT UNIQUE COLLATE NOCASE)');
 $dbh->do('CREATE TABLE CHANNEL_SET(id_channel_set INTEGER PRIMARY KEY,id_channel INTEGER,id_chanset_list INTEGER)');
 $dbh->do("INSERT INTO CHANNEL VALUES(1,'#pilot'),(2,'#other'),(3,'#new')");
 $dbh->do("INSERT INTO CHANSET_LIST VALUES(1,'chatGPT'),(2,'Hailo')");
 $dbh->do('INSERT INTO CHANNEL_SET(id_channel,id_chanset_list) VALUES(1,1),(2,1),(3,1),(1,2)');
 $dbh->sqlite_create_function('DATABASE',0,sub {'test_database'});
 $dbh->sqlite_create_function('GET_LOCK',2,sub {1});
 $dbh->sqlite_create_function('RELEASE_LOCK',1,sub {1});
 my $c=bless {'meta_ai.ENABLED'=>1,'meta_ai.CHANNELS'=>'#pilot #other #missing'},'MB842Conf';
 return ($dbh,$c,{dbh=>$dbh,conf=>$c});
}
my ($dbh,$conf,$bot)=fixture842();
my $cfg=settings($conf);
my $empty=settings(bless {},'MB842Conf');
is($empty->{enabled},1,'new opt-in chanset needs no configuration activation key');
is($empty->{legacy_enabled},0,'missing old activation key grants no legacy access');
my $p=channel_policy($bot,$cfg,'#pilot');
is($p->{mode},'legacy','database without new catalogue retains explicit transition mode');
ok($p->{enabled},'old eligible listed channel continues before adoption');
ok(!channel_policy($bot,$cfg,'#new')->{enabled},'unlisted old chatGPT channel is not adopted implicitly');
is(channel_policy({},$cfg,'#pilot')->{mode},'unavailable','missing database is distinct from a missing catalogue');
ok(!channel_policy({},$cfg,'#pilot')->{enabled},'database failure cannot grant legacy access');
my $plan=activation_plan($dbh,$cfg);
is_deeply($plan->{adopt},['#other','#pilot'],'preview adopts only currently enabled listed channels');
is_deeply($plan->{omitted},['#missing'],'unknown legacy channel is reported, not inserted');
is($dbh->selectrow_array("SELECT COUNT(*) FROM CHANSET_LIST WHERE chanset='MetaAI'"),0,'preview creates no catalogue row');
my @sql;$dbh->sqlite_trace(sub {push @sql,$_[0]});
my $r=initialize_chanset($dbh,$cfg,adopt_legacy=>1);
ok($r->{created},'explicit initialization registers MetaAI');
is_deeply($r->{active},['#other','#pilot'],'eligible existing channels survive atomic handover');
ok(!grep(/\A\s*(?:ALTER|CREATE|DROP|TRUNCATE)\b/i,@sql),'initialization has no schema operation');
is($dbh->selectrow_array('SELECT COUNT(*) FROM CHANNEL_SET WHERE id_chanset_list=1'),3,'legacy chatGPT flags are retained for explicit legacy commands');
is($dbh->selectrow_array('SELECT COUNT(*) FROM CHANNEL_SET WHERE id_chanset_list=2'),1,'unrelated flags are retained');
is(channel_policy($bot,$cfg,'#pilot')->{mode},'chanset','registered database selects the channel policy');
ok(channel_policy($bot,$cfg,'#PILOT')->{enabled},'native policy accepts database case equivalence');
ok(!channel_policy($bot,$cfg,'#new')->{enabled},'new unflagged channel remains off despite chatGPT');
my ($id)=$dbh->selectrow_array("SELECT id_chanset_list FROM CHANSET_LIST WHERE chanset='MetaAI'");
$dbh->do('INSERT INTO CHANNEL_SET(id_channel,id_chanset_list) VALUES(3,?)',undef,$id);
$conf->{'meta_ai.CHANNELS'}='';$cfg=settings($conf);
ok(channel_policy($bot,$cfg,'#new')->{enabled},'native +MetaAI needs no allowlist entry');
$dbh->do('DELETE FROM CHANNEL_SET WHERE id_channel=3 AND id_chanset_list=1');
ok(channel_policy($bot,$cfg,'#new')->{enabled},'native +MetaAI is independent of legacy +chatGPT');
$dbh->do('DELETE FROM CHANNEL_SET WHERE id_channel=3 AND id_chanset_list=?',undef,$id);
ok(!channel_policy($bot,$cfg,'#new')->{enabled},'removal is visible immediately without a cache TTL');
$dbh->do('DELETE FROM CHANNEL_SET WHERE id_channel=1 AND id_chanset_list=?',undef,$id);
$conf->{'meta_ai.CHANNELS'}='#pilot #other';$cfg=settings($conf);
$r=initialize_chanset($dbh,$cfg,adopt_legacy=>1);
ok(!$r->{created},'repeated initialization is a no-op after registration');
ok(!channel_policy($bot,$cfg,'#pilot')->{enabled},'repeated adoption cannot resurrect a removed MetaAI flag');
is_deeply($r->{active},['#other'],'explicitly disabled channel stays disabled');
$conf->{'meta_ai.ENABLED'}=0;
ok(!channel_policy($bot,settings($conf),'#other')->{enabled},'explicit global emergency switch still disables native channels');
delete $conf->{'meta_ai.ENABLED'};
ok(channel_policy($bot,settings($conf),'#other')->{enabled},'removing emergency override restores explicit channel flag');
for my $bad ('Alice','#bad,other',undef,[]) {ok(!channel_policy($bot,settings($conf),$bad)->{enabled},'invalid/non-channel scope grants no access')}
$dbh->do('DROP TABLE CHANNEL_SET');
is(channel_policy($bot,settings($conf),'#other')->{mode},'unavailable','broken native channel lookup is reported');
ok(!channel_policy($bot,settings($conf),'#other')->{enabled},'native lookup error cannot fall back to allowlist');

($dbh,$conf,$bot)=fixture842();$cfg=settings($conf);
$r=initialize_chanset($dbh,$cfg);
is_deeply($r->{active},[],'registration without adoption enables no channel');
ok(!channel_policy($bot,$cfg,'#pilot')->{enabled},'new catalogue makes legacy list non-authoritative');
($dbh,$conf,$bot)=fixture842();$conf->{'meta_ai.ENABLED'}=0;
$r=initialize_chanset($dbh,settings($conf),adopt_legacy=>1);
is_deeply($r->{active},[],'disabled old mode enables no channels on adoption');

($dbh,$conf,$bot)=fixture842();$cfg=settings($conf);
$dbh->do(q{CREATE TRIGGER reject_meta BEFORE INSERT ON CHANNEL_SET WHEN NEW.id_chanset_list>2 AND NEW.id_channel=1 BEGIN SELECT RAISE(ABORT,'private injected write error'); END});
my $ok=eval {initialize_chanset($dbh,$cfg,adopt_legacy=>1);1};
ok(!$ok,'failed adoption aborts');
unlike($@,qr/private injected/,'transaction error does not expose private SQL detail');
is($dbh->selectrow_array("SELECT COUNT(*) FROM CHANSET_LIST WHERE chanset='MetaAI'"),0,'failed adoption rolls catalogue registration back');
is($dbh->selectrow_array('SELECT COUNT(*) FROM CHANNEL_SET WHERE id_chanset_list>2'),0,'failed adoption leaves no partially adopted channel');
ok(channel_policy($bot,$cfg,'#pilot')->{enabled},'failed adoption leaves old working route available');
$dbh->do('DROP TRIGGER reject_meta');
$dbh->sqlite_create_function('GET_LOCK',2,sub {0});
$ok=eval {initialize_chanset($dbh,$cfg,adopt_legacy=>1);1};
ok(!$ok,'busy initializer refuses without waiting');
is($dbh->selectrow_array("SELECT COUNT(*) FROM CHANSET_LIST WHERE chanset='MetaAI'"),0,'refused lock creates nothing');
done_testing;
