[Unit]
Description=Mediabot private URL creation and public redirect service
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=mediabot
Group=mediabot
WorkingDirectory=/opt/mediabot-shorturl/app
ExecStart=/usr/bin/python3 -B /opt/mediabot-shorturl/app/shorturl_service.py --config /var/lib/mediabot-shorturl/control/service.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
SystemCallArchitectures=native
ReadOnlyPaths=/opt/mediabot-shorturl/app
ReadWritePaths=/var/lib/mediabot-shorturl
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
