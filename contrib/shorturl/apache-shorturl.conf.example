# Insert these directives inside the existing HTTPS VirtualHost for the host.
# Do not enable this as an unrestricted global Apache configuration.

ProxyPass        /shorturl/ http://127.0.0.1:8766/shorturl/ connectiontimeout=3 timeout=5 retry=0
ProxyPassReverse /shorturl/ http://127.0.0.1:8766/shorturl/

<Location "/shorturl/">
    Require method GET HEAD POST
    LimitRequestBody 8192
    RewriteEngine On
    RewriteCond expr "req('Content-Length') -gt 8192"
    RewriteRule ^ - [R=413,END]
    RewriteCond %{HTTP:Transfer-Encoding} !^$
    RewriteRule ^ - [R=413,END]
    ProxyErrorOverride Off
    Header always set Cache-Control "no-store"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Robots-Tag "noindex, nofollow"
</Location>
