{
  "id": null,
  "uid": "mediabot-instance-minute",
  "title": "Mediabot · En direct",
  "description": "Une seule instance Mediabot : état du bot, rythme des conversations, commandes publiques et analyses de liens.",
  "tags": [
    "mediabot",
    "irc",
    "instance"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "style": "dark",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "15m",
      "1h",
      "6h",
      "12h",
      "24h",
