    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "## Mediabot · En direct\nUne instance, son état et son activité récente. **/min** = rythme moyen ; **—** = mesure indisponible."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Collecte des statistiques",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "description": "Prometheus arrive à lire les métriques de l’instance.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(up{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}) or on() vector(-1)",
          "legendFormat": "Collecte des statistiques",
          "editorMode": "code",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Interrompue",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Disponible",
                  "color": "green",
                  "index": 1
                },
                "-1": {
                  "text": "Non mesuré",
                  "color": "gray",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Connexion IRC",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "description": "Le bot est connecté au réseau IRC.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(max(mediabot_irc_connected{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}) and on() (max(up{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}) == 1)) or on() vector(-1)",
          "legendFormat": "Connexion IRC",
          "editorMode": "code",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Déconnecté",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Connecté",
                  "color": "green",
                  "index": 1
                },
                "-1": {
                  "text": "Non mesuré",
                  "color": "gray",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Base du bot",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "description": "Dernier état connu de la connexion à la base de Mediabot.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "((max(mediabot_db_up{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}) or on() max(mediabot_db_connected{job=~\"${job:regex}\",instance=~\"${instance:regex}\"})) and on() (max(up{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}) == 1)) or on() vector(-1)",
          "legendFormat": "Base du bot",
          "editorMode": "code",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Indisponible",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Disponible",
                  "color": "green",
                  "index": 1
                },
                "-1": {
                  "text": "Non mesuré",
                  "color": "gray",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
