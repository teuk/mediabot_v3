    {
      "id": 7,
      "type": "stat",
      "title": "Messages lus",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 6,
        "h": 4
      },
      "description": "Lignes publiques comptées par Mediabot dans ses salons.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(60 * sum(rate(mediabot_channel_lines_in_total{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}[5m])) or on() (0 * (max(up{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}) == 1) and on() mediabot_build_info{job=~\"${job:regex}\",instance=~\"${instance:regex}\"} unless on() mediabot_channel_lines_in_total{job=~\"${job:regex}\",instance=~\"${instance:regex}\"})) and on() (max(up{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}) == 1)",
          "legendFormat": "Messages lus",
          "editorMode": "code",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: /min",
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "#2DD4BF"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ]
        }
      }
    },
